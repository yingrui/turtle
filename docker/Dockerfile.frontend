ARG FRONTEND_BASE=turtle-frontend-base:latest

# ---- production SPA (nginx + built assets) ----
FROM ${FRONTEND_BASE} AS build

WORKDIR /src

COPY frontend ./

ARG VITE_API_URL=
ENV VITE_API_URL=${VITE_API_URL}
ARG VITE_BASE=/
ENV VITE_BASE=${VITE_BASE}

RUN npm run build

FROM nginx:alpine AS frontend-prod

COPY --from=build /src/dist /usr/share/nginx/html
COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 3200

# ---- Dev / test — Vite DevServer (openKMS hot reload) ----
FROM ${FRONTEND_BASE} AS frontend

WORKDIR /src

COPY frontend ./

ARG VITE_API_URL=
ENV VITE_API_URL=${VITE_API_URL}
# Default `/`; K8s Deployment overrides with openKMS Service-proxy prefix.
ARG VITE_BASE=/
ENV VITE_BASE=${VITE_BASE}
ENV VITE_PROXY_TARGET=http://backend:8200
ENV VITE_HMR=false

EXPOSE 3200

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3200"]
