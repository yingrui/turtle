ARG FRONTEND_BASE=turtle-frontend-base:latest
FROM ${FRONTEND_BASE} AS build

WORKDIR /src

COPY frontend ./

ARG VITE_API_URL=
ENV VITE_API_URL=${VITE_API_URL}
# Use ./ for openKMS service-proxy / subpath hosting; leave unset for Compose (root /).
ARG VITE_BASE=/
ENV VITE_BASE=${VITE_BASE}

RUN npm run build

FROM nginx:alpine

COPY --from=build /src/dist /usr/share/nginx/html
COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 3200
