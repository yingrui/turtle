# Rebuild when backend/pyproject.toml dependencies change:
#   docker build -f docker/Dockerfile.backend-base -t turtle-backend-base:latest .
FROM python:3.12-slim-bookworm

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Install project deps only (stub package so setuptools/pip -e works).
COPY backend/pyproject.toml /app/backend/pyproject.toml
WORKDIR /app/backend
RUN mkdir -p app \
    && printf '"""stub for base image dep install"""\n' > app/__init__.py \
    && pip install --no-cache-dir -e . \
    && rm -rf app

ENV PYTHONPATH=/app/backend
ENV STOCK_LOGS_DIR=/app/logs

RUN mkdir -p /app/logs
