# Copy to backend/.env and edit.
# dev.sh also loads ../.env and ../docker/.env if present.

# --- Auth: local ---
STOCK_AUTH_MODE=local
STOCK_ALLOW_SIGNUP=true
STOCK_LOCAL_JWT_EXP_HOURS=168
STOCK_SECRET_KEY=stock-dev-secret-change-in-production

# --- PostgreSQL ---
STOCK_DATABASE_HOST=localhost
STOCK_DATABASE_PORT=5432
STOCK_DATABASE_USER=stock
STOCK_DATABASE_PASSWORD=stock
STOCK_DATABASE_NAME=stock

# Optional: override composed URL (e.g. sqlite for tests)
# DB_URL=postgresql+psycopg2://stock:stock@localhost:5432/stock

# --- Tushare ---
TUSHARE_TOKEN=your-tushare-token

# --- Paths (dev.sh sets repo-relative defaults when unset) ---
STOCK_LOGS_DIR=../logs
STOCK_FRONTEND_URL=http://localhost:3200
