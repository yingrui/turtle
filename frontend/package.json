{
  "name": "stock-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "check:styles": "python3 scripts/check-styles.py",
    "check": "npm run typecheck && npm run check:styles && npm run check:classes && npm run check:i18n && npm run check:a11y && npm run test && npm run build",
    "check:i18n": "python3 scripts/check-i18n.py",
    "check:classes": "python3 scripts/check-classes.py",
    "check:a11y": "python3 scripts/check-a11y.py"
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "i18next": "^25.0.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.0",
    "react-router-dom": "^7.6.0",
    "sonner": "^2.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "sass": "^1.87.0",
    "typescript": "~5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
